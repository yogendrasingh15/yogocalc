<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1">Customer details</h1>
      <p class="text-muted mb-0">View profile information and linked accounts.</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "Edit customer", edit_customer_path(@customer), class: "btn btn-outline-primary" %>
      <%= link_to "Back to customers", customers_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <div class="row g-4">
        <div class="col-md-6">
          <h5 class="fw-semibold mb-3">Profile</h5>
          <dl class="row mb-0">
            <dt class="col-sm-5">Customer #</dt>
            <dd class="col-sm-7"><%= @customer.customer_number %></dd>
            <dt class="col-sm-5">Name</dt>
            <dd class="col-sm-7"><%= @customer.full_name %></dd>
            <dt class="col-sm-5">Type</dt>
            <dd class="col-sm-7"><%= @customer.customer_type.humanize %></dd>
            <dt class="col-sm-5">Status</dt>
            <dd class="col-sm-7"><span class="badge bg-success-subtle text-success-emphasis"><%= @customer.status.humanize %></span></dd>
          </dl>
        </div>
        <div class="col-md-6">
          <h5 class="fw-semibold mb-3">Additional details</h5>
          <dl class="row mb-0">
            <dt class="col-sm-5">DOB</dt>
            <dd class="col-sm-7"><%= @customer.date_of_birth.present? ? @customer.date_of_birth.strftime("%d %b %Y") : "—" %></dd>
            <dt class="col-sm-5">Gender</dt>
            <dd class="col-sm-7"><%= @customer.gender.presence || "—" %></dd>
            <dt class="col-sm-5">Nationality</dt>
            <dd class="col-sm-7"><%= @customer.nationality.presence || "—" %></dd>
            <dt class="col-sm-5">Customer since</dt>
            <dd class="col-sm-7"><%= @customer.customer_since.present? ? @customer.customer_since.strftime("%d %b %Y") : "—" %></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0 mt-4">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-semibold mb-0">Accounts</h5>
        <%= link_to "New account", new_account_path, class: "btn btn-sm btn-primary" %>
      </div>
      <% if @customer.accounts.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Account #</th>
                <th>Type</th>
                <th>Status</th>
                <th>Balance</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @customer.accounts.each do |account| %>
                <tr>
                  <td><%= account.account_number %></td>
                  <td><%= account.account_type.humanize %></td>
                  <td><span class="badge bg-info-subtle text-info-emphasis"><%= account.account_status %></span></td>
                  <td><%= number_to_currency(account.balance, unit: account.currency_code, format: "%u %n") %></td>
                  <td>
                    <%= link_to "View", account_path(account), class: "btn btn-sm btn-outline-primary" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-info mb-0">No accounts linked yet.</div>
      <% end %>
    </div>
  </div>
</div>
