<p style="color: green"><%= notice %></p>

<h1>Tickets</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
  <%= link_to "New ticket", new_ticket_path, class: "btn btn-primary" %>
</div>

<div id="tickets">
  <% if @tickets.any? %>
    <table class="table table-striped table-bordered">
      <thead>
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Status</th>
          <th>Project</th>
          <th>Priority</th>
          <th>Due date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @tickets.each_with_index do |ticket, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= ticket.title %></td>
            <td><span class="badge bg-info text-dark"><%= ticket.status.to_s.humanize %></span></td>
            <td><%= Ticket::PROJECT_OPTIONS.find { |_, value| value == ticket.project_id }&.first || ticket.project_id %></td>
            <td><%= Ticket::PRIORITY_OPTIONS.find { |_, value| value == ticket.priority }&.first || ticket.priority %></td>
            <td><%= ticket.due_date.present? ? ticket.due_date.strftime("%d %b %Y") : "Not set" %></td>
            <td>
              <%= link_to "Show", ticket, class: "btn btn-sm btn-outline-primary" %>
              <%= link_to "Edit", edit_ticket_path(ticket), class: "btn btn-sm btn-outline-secondary" %>
              <%= button_to "Delete", ticket, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="alert alert-info">No tickets yet.</div>
  <% end %>
</div>
