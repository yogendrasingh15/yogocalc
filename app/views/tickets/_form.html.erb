<%= form_with(model: ticket, local: true) do |form| %>
  <% if ticket.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(ticket.errors.count, "error") %> prohibited this ticket from being saved:</h2>

      <ul>
        <% ticket.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title %><br>
    <%= form.text_field :title, required: true %>
  </div>

  <div>
    <%= form.label :description %><br>
    <%= form.text_area :description, rows: 4 %>
  </div>

  <div>
    <%= form.label :project_id, "Project" %><br>
    <%= form.select :project_id, options_for_select(Ticket::PROJECT_OPTIONS, ticket.project_id), { include_blank: "Select a project" } %>
  </div>

  <div>
    <%= form.label :status %><br>
    <%= form.select :status, options_for_select(Ticket::STATUS_OPTIONS.map { |value| [value.humanize, value] }, ticket.status), { include_blank: false } %>
  </div>

  <div>
    <%= form.label :location %><br>
    <%= form.text_field :location %>
  </div>

  <div>
    <%= form.label :due_date %><br>
    <%= form.date_field :due_date %>
  </div>

  <div>
    <%= form.label :priority %><br>
    <%= form.select :priority, options_for_select(Ticket::PRIORITY_OPTIONS, ticket.priority), { include_blank: false } %>
  </div>

  <div style="margin-top: 12px">
    <%= form.submit %>
  </div>
<% end %>
