<h1>Profile</h1>

<p>
  <strong>Name:</strong>
  <%= @profile.name %>
</p>

<p>
  <strong>Email:</strong>
  <%= @profile.email %>
</p>

<p>
  <strong>Address:</strong>
  <%= simple_format(@profile.address) %>
</p>

<p>
  <strong>Mobile:</strong>
  <%= @profile.mobile %>
</p>

<p>
  <strong>Pincode:</strong>
  <%= @profile.pincode %>
</p>

<p>
  <strong>Gender:</strong>
  <%= @profile.gender %>
</p>

<%= link_to 'Edit', edit_profile_path(@profile), class: 'btn btn-secondary' %>
<%= link_to 'Back', profiles_path, class: 'btn btn-link' %>
