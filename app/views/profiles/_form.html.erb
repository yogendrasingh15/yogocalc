<%= form_with(model: profile, local: true) do |form| %>
  <% if profile.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(profile.errors.count, "error") %> prohibited this profile from being saved:</h2>
      <ul>
        <% profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :email %>
    <%= form.email_field :email, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :address %>
    <%= form.text_area :address, rows: 3, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :mobile %>
    <%= form.text_field :mobile, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :pincode %>
    <%= form.text_field :pincode, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :gender %>
    <%= form.select :gender, options_for_select([['Male','male'], ['Female','female'], ['Other','other']], profile.gender), include_blank: true, class: 'form-control' %>
  </div>

  <div class="actions mt-3">
    <%= form.submit class: 'btn btn-primary' %>
  </div>
<% end %>
