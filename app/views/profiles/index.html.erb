<h1>Profiles</h1>

<p><%= link_to 'New Profile', new_profile_path, class: 'btn btn-primary' %></p>

<table class="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Mobile</th>
      <th>Pincode</th>
      <th>Gender</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @profiles.each do |profile| %>
      <tr>
        <td><%= profile.name %></td>
        <td><%= profile.email %></td>
        <td><%= profile.mobile %></td>
        <td><%= profile.pincode %></td>
        <td><%= profile.gender %></td>
        <td>
          <%= link_to 'Show', profile_path(profile), class: 'btn btn-sm btn-secondary' %>
          <%= link_to 'Edit', edit_profile_path(profile), class: 'btn btn-sm btn-secondary' %>
          <%= link_to 'Destroy', profile_path(profile), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-sm btn-danger' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
