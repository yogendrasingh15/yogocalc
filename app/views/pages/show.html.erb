<div class="container py-4">
  <% if notice.present? %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <%= render 'shared/page_header', title: @page.title, subtitle: @page.path.presence || "/#{@page.slug}", action_button: [{ label: 'Edit', path: edit_page_path(@page), style: 'primary' }, { label: 'Back', path: pages_path, style: 'secondary' }] %>

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <div class="row g-4">
        <div class="col-md-6">
          <p><strong>Slug:</strong> /<%= @page.slug %></p>
          <p><strong>Path:</strong> <%= @page.path.presence || 'Not set' %></p>
          <p><strong>Status:</strong> <span class="badge <%= @page.status == 'published' ? 'bg-success' : @page.status == 'archived' ? 'bg-secondary' : 'bg-warning text-dark' %>"><%= @page.status.humanize %></span></p>
          <p><strong>Homepage:</strong> <%= @page.is_homepage? ? 'Yes' : 'No' %></p>
        </div>
        <div class="col-md-6">
          <p><strong>Site ID:</strong> <%= @page.site_id || 'Not set' %></p>
          <p><strong>Parent ID:</strong> <%= @page.parent_id || 'Not set' %></p>
          <p><strong>Template ID:</strong> <%= @page.template_id || 'Not set' %></p>
          <p><strong>Published at:</strong> <%= @page.published_at&.strftime('%d %b %Y %H:%M') || 'Not set' %></p>
        </div>
      </div>

      <hr>
      <h5 class="fw-bold">Content</h5>
      <div class="bg-light p-3 rounded"><%= simple_format(@page.content) %></div>

      <div class="mt-4 d-flex gap-2">
        <%= link_to 'Edit', edit_page_path(@page), class: 'btn btn-primary' %>
        <%= button_to 'Delete', @page, method: :delete, class: 'btn btn-outline-danger', form: { data: { turbo_confirm: 'Are you sure?' } } %>
      </div>
    </div>
  </div>
</div>
