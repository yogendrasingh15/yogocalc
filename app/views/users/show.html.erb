<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1"><%= @user.name.presence || "User details" %></h1>
      <p class="text-muted mb-0">Review account and contact information.</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "Edit", edit_user_path(@user), class: "btn btn-primary" %>
      <%= link_to "Back to users", users_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9"><%= @user.email %></dd>
        <dt class="col-sm-3">Mobile</dt><dd class="col-sm-9"><%= @user.mobile.presence || "-" %></dd>
        <dt class="col-sm-3">WhatsApp</dt><dd class="col-sm-9"><%= @user.is_whatsapp? ? "Yes" : "No" %></dd>
        <dt class="col-sm-3">Date of birth</dt><dd class="col-sm-9"><%= @user.dob.presence || "-" %></dd>
        <dt class="col-sm-3">Gender</dt><dd class="col-sm-9"><%= @user.gender.presence || "-" %></dd>
        <dt class="col-sm-3">Address</dt><dd class="col-sm-9"><%= @user.address.presence || "-" %></dd>
      </dl>
    </div>
  </div>
</div>