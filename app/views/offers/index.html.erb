<div class="container py-4">
  <div class="card border-0 shadow-sm overflow-hidden mb-4" style="background: linear-gradient(135deg, #0b1f4d 0%, #1d4ed8 100%); color: white;">
    <div class="card-body p-4 p-lg-5">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <p class="text-uppercase small fw-semibold mb-2 text-white-50">Travel operator</p>
          <h1 class="h2 mb-0 text-white">Offer dashboard</h1>
        </div>
        <%= link_to "New offer", new_offer_path, class: "btn btn-light text-primary fw-semibold" %>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">Active deals</span>
            <span class="badge bg-primary-subtle text-primary-emphasis"><i class="bi bi-briefcase"></i></span>
          </div>
          <div class="display-6 fw-bold"><%= Offer.where(status: "active").count %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">Featured</span>
            <span class="badge bg-warning-subtle text-warning-emphasis"><i class="bi bi-star-fill"></i></span>
          </div>
          <div class="display-6 fw-bold"><%= Offer.where(is_featured: true).count %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">Total value</span>
            <span class="badge bg-success-subtle text-success-emphasis"><i class="bi bi-currency-rupee"></i></span>
          </div>
          <div class="display-6 fw-bold"><%= number_to_currency(Offer.sum(:price), unit: "₹") %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">Avg. discount</span>
            <span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-tag"></i></span>
          </div>
          <div class="display-6 fw-bold"><%= Offer.average(:discount_percentage)&.round(1) || 0 %>%</div>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2 mb-4">
    <span class="badge bg-primary-subtle text-primary-emphasis px-3 py-2">All offers</span>
    <span class="badge bg-light text-dark px-3 py-2">Featured</span>
    <span class="badge bg-light text-dark px-3 py-2">Hot deals</span>
    <span class="badge bg-light text-dark px-3 py-2">Weekend getaways</span>
  </div>

  <% if @offers.any? %>
    <div class="row g-4" id="offers">
      <% @offers.each do |offer| %>
        <div class="col-lg-4">
          <div class="card h-100 border-0 shadow-sm overflow-hidden">
            <div class="position-relative">
              <% if offer.image_url.present? && (offer.image_url.start_with?("http://", "https://", "/")) %>
                <%= image_tag offer.image_url, class: "card-img-top", style: "height: 220px; object-fit: cover;" %>
              <% else %>
                <div class="card-img-top d-flex align-items-center justify-content-center text-white fw-bold" style="height: 220px; background: linear-gradient(135deg, #1d4ed8 0%, #7c3aed 100%); font-size: 1.3rem;">
                  <%= offer.destination.presence || offer.title.to_s.first(2).upcase %>
                </div>
              <% end %>
              <% if offer.is_featured %>
                <span class="position-absolute top-0 start-0 m-3 badge bg-warning text-dark">Featured</span>
              <% end %>
            </div>

            <div class="card-body d-flex flex-column p-3">
              <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <div>
                  <p class="text-primary small fw-semibold mb-1"><%= offer.offer_type.humanize %></p>
                  <h5 class="card-title mb-0"><%= offer.title %></h5>
                </div>
                <span class="badge bg-light text-dark"><%= offer.status.humanize %></span>
              </div>

              <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i><%= offer.destination %></p>
              <p class="card-text text-muted flex-grow-1"><%= truncate(offer.description, length: 110) %></p>

              <div class="d-flex align-items-baseline gap-2 mb-3">
                <span class="fs-4 fw-bold text-primary"><%= number_to_currency(offer.price, unit: "₹") %></span>
                <span class="text-decoration-line-through text-muted small"><%= number_to_currency(offer.original_price, unit: "₹") %></span>
              </div>

              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-success-subtle text-success-emphasis"><%= offer.discount_percentage %>% off</span>
                <small class="text-muted"><%= offer.start_date.strftime("%b %d") %> - <%= offer.end_date.strftime("%b %d") %></small>
              </div>

              <div class="d-flex gap-2 mt-auto">
                <%= link_to "View", offer_path(offer), class: "btn btn-outline-primary btn-sm flex-grow-1" %>
                <%= link_to "Edit", edit_offer_path(offer), class: "btn btn-outline-secondary btn-sm" %>
                <%= button_to "Delete", offer_path(offer), method: :delete, class: "btn btn-outline-danger btn-sm", form: { data: { turbo_confirm: "Are you sure you want to remove this offer?" } } %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info border-0 shadow-sm">No offers available yet. Create your first travel deal.</div>
  <% end %>
</div>
