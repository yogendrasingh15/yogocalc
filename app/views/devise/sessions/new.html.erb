<div class="container login-page">
  <div class="row justify-content-center align-items-center min-vh-100 py-5">
    <div class="col-xl-10">
      <div class="card login-card shadow-sm overflow-hidden border-0">
        <div class="row g-0">
          <div class="col-md-5 login-card-hero text-white d-flex flex-column justify-content-between p-5">
            <div>
              <div class="badge bg-white text-primary mb-4">Welcome Back</div>
              <h1 class="display-6 fw-bold mb-3">Sign in to DRY Solutions</h1>
              <p class="text-white-75">Secure access to your calculators, workflows, and dry solution insights.</p>
            </div>

            <div class="mt-5">
              <div class="feature-item d-flex align-items-start mb-3">
                <span class="feature-icon bg-white text-primary me-3">
                  <i class="bi bi-speedometer2"></i>
                </span>
                <div>
                  <h6 class="mb-1 text-white">Fast access</h6>
                  <p class="mb-0 text-white-75">Jump back into the dashboard instantly.</p>
                </div>
              </div>
              <div class="feature-item d-flex align-items-start mb-3">
                <span class="feature-icon bg-white text-primary me-3">
                  <i class="bi bi-shield-lock"></i>
                </span>
                <div>
                  <h6 class="mb-1 text-white">Secure login</h6>
                  <p class="mb-0 text-white-75">Protected authentication for your account.</p>
                </div>
              </div>
              <div class="feature-item d-flex align-items-start">
                <span class="feature-icon bg-white text-primary me-3">
                  <i class="bi bi-graph-up"></i>
                </span>
                <div>
                  <h6 class="mb-1 text-white">Smart controls</h6>
                  <p class="mb-0 text-white-75">Manage nominees, contacts, roles and more with ease.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-7 p-5">
            <div class="login-card-form h-100 d-flex flex-column justify-content-center">
              <div>
                <h2 class="fw-bold mb-2">Login to your account</h2>
                <p class="text-muted mb-4">Enter your email and password to continue.</p>
                <%= devise_error_messages! %>

                <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
                  <div class="form-group mb-4">
                    <%= f.label :email, class: 'form-label' %>
                    <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'form-control', placeholder: 'name@example.com' %>
                  </div>

                  <div class="form-group mb-4">
                    <%= f.label :password, class: 'form-label' %>
                    <%= f.password_field :password, autocomplete: 'current-password', class: 'form-control', placeholder: 'Enter your password' %>
                  </div>

                  <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                      <%= f.check_box :remember_me, class: 'form-check-input', id: 'remember_me' %>
                      <%= f.label :remember_me, class: 'form-check-label mb-0' %>
                    </div>
                    <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
                      <%= link_to 'Forgot your password?', new_password_path(resource_name), class: 'form-link' %>
                    <% end %>
                  </div>

                  <%= f.submit 'Continue', class: 'btn btn-primary btn-lg w-100 mb-3' %>
                <% end %>

                <div class="text-center mt-3">
                  <span class="text-muted">New to DRY Solutions?</span>
                  <%= link_to 'Create an account', new_registration_path(resource_name), class: 'form-link fw-semibold ms-1' %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
