<!-- app/views/shared/_page_header.html.erb -->
<div class="page-header mb-4">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1"><%= local_assigns[:title] %></h1>
      <% if local_assigns[:subtitle] %>
        <p class="text-muted mb-0"><%= local_assigns[:subtitle] %></p>
      <% end %>
    </div>
    <% if local_assigns[:action_button] %>
      <div class="btn-group" role="group">
        <% local_assigns[:action_button].each do |btn| %>
          <%= link_to btn[:label], btn[:path], class: "btn btn-#{btn[:style] || 'primary'} btn-sm" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
