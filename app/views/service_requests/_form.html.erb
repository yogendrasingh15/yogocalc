<%= form_with model: service_request, local: true, class: "service-request-form" do |form| %>
  <% if service_request.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2 class="h6 alert-heading"><%= pluralize(service_request.errors.count, "error") %> prevented this request from being saved.</h2>
      <ul class="mb-0">
        <% service_request.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3 p-lg-4">
      <h2 class="h5 fw-bold mb-1">Request details</h2>
      <p class="text-muted small mb-4">Describe the issue and identify the customer and solar equipment involved.</p>
      <div class="row g-3">
        <div class="col-md-6">
          <%= form.label :customer_id, "Customer", class: "form-label fw-semibold" %>
          <%= form.collection_select :customer_id, Customer.order(:customer_number), :id, :full_name, { include_blank: "Choose a customer" }, class: "form-select" %>
        </div>
        <div class="col-md-4">
          <%= form.label :request_type, class: "form-label fw-semibold" %>
          <%= form.select :request_type, ServiceRequest::REQUEST_TYPES.map { |value| [value.humanize, value] }, { include_blank: "Choose a type" }, class: "form-select", required: true %>
        </div>
        <div class="col-md-4">
          <%= form.label :category, class: "form-label fw-semibold" %>
          <%= form.text_field :category, class: "form-control", placeholder: "e.g. Inverter" %>
        </div>
        <div class="col-md-4">
          <%= form.label :subcategory, class: "form-label fw-semibold" %>
          <%= form.text_field :subcategory, class: "form-control", placeholder: "e.g. Power fault" %>
        </div>
        <div class="col-12">
          <%= form.label :title, class: "form-label fw-semibold" %>
          <%= form.text_field :title, class: "form-control", required: true, placeholder: "Summarize the issue in a few words" %>
        </div>
        <div class="col-12">
          <%= form.label :description, class: "form-label fw-semibold" %>
          <%= form.text_area :description, rows: 4, class: "form-control", placeholder: "Add symptoms, troubleshooting already attempted, and other useful context." %>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3 p-lg-4">
      <h2 class="h5 fw-bold mb-1">Routing and service level</h2>
      <p class="text-muted small mb-4">Record how the request arrived, its urgency, and its current owner.</p>
      <div class="row g-3">
        <div class="col-md-6 col-lg-3">
          <%= form.label :reported_channel, "Reported channel", class: "form-label fw-semibold" %>
          <%= form.select :reported_channel, ServiceRequest::REPORTED_CHANNELS.map { |value| [value.humanize, value] }, { include_blank: "Choose a channel" }, class: "form-select", required: true %>
        </div>
        <div class="col-md-6 col-lg-3">
          <%= form.label :reported_by, class: "form-label fw-semibold" %>
          <%= form.text_field :reported_by, class: "form-control", placeholder: "Name or system" %>
        </div>
        <div class="col-md-4 col-lg-2">
          <%= form.label :priority, class: "form-label fw-semibold" %>
          <%= form.select :priority, ServiceRequest::PRIORITIES.map { |value| [value.humanize, value] }, {}, class: "form-select" %>
        </div>
        <div class="col-md-4 col-lg-2">
          <%= form.label :severity, class: "form-label fw-semibold" %>
          <%= form.select :severity, ServiceRequest::SEVERITIES.map { |value| [value.humanize, value] }, {}, class: "form-select" %>
        </div>
        <div class="col-md-4 col-lg-2">
          <%= form.label :status, class: "form-label fw-semibold" %>
          <%= form.select :status, ServiceRequest::STATUSES.map { |value| [value.humanize, value] }, {}, class: "form-select" %>
        </div>
        <div class="col-md-4">
          <%= form.label :acknowledged_at, class: "form-label fw-semibold" %>
          <%= form.datetime_local_field :acknowledged_at, class: "form-control" %>
        </div>
        <div class="col-md-4">
          <%= form.label :resolved_at, class: "form-label fw-semibold" %>
          <%= form.datetime_local_field :resolved_at, class: "form-control" %>
        </div>
        <div class="col-md-4">
          <%= form.label :closed_at, class: "form-label fw-semibold" %>
          <%= form.datetime_local_field :closed_at, class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= form.label :attachments_count, class: "form-label fw-semibold" %>
          <%= form.number_field :attachments_count, min: 0, class: "form-control" %>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3 p-lg-4">
      <h2 class="h5 fw-bold mb-1">Site and visit</h2>
      <p class="text-muted small mb-4">Link this request to a tenant and solar equipment, then capture visit preferences.</p>
      <div class="row g-3">
        <div class="col-md-6 col-lg-3">
          <%= form.label :tenant_id, class: "form-label fw-semibold" %>
          <%= form.number_field :tenant_id, min: 1, class: "form-control" %>
        </div>
        <div class="col-md-6 col-lg-3">
          <%= form.label :solar_site_id, class: "form-label fw-semibold" %>
          <%= form.number_field :solar_site_id, min: 1, class: "form-control" %>
        </div>
        <div class="col-md-6 col-lg-3">
          <%= form.label :solar_system_id, class: "form-label fw-semibold" %>
          <%= form.number_field :solar_system_id, min: 1, class: "form-control" %>
        </div>
        <div class="col-md-6 col-lg-3">
          <%= form.label :solar_component_id, class: "form-label fw-semibold" %>
          <%= form.number_field :solar_component_id, min: 1, class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= form.label :preferred_visit_date, class: "form-label fw-semibold" %>
          <%= form.date_field :preferred_visit_date, class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= form.label :preferred_visit_time, class: "form-label fw-semibold" %>
          <%= form.time_field :preferred_visit_time, class: "form-control" %>
        </div>
        <div class="col-12">
          <div class="form-check">
            <%= form.check_box :customer_visible, class: "form-check-input" %>
            <%= form.label :customer_visible, "Visible to the customer", class: "form-check-label fw-semibold" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= form.submit service_request.persisted? ? "Save changes" : "Create request", class: "btn btn-primary px-4" %>
    <%= link_to "Cancel", service_request.persisted? ? service_request_path(service_request) : service_requests_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
