<div class="page-section page-nominee-index">
  <div class="container-fluid py-5">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3 mb-4">
      <div>
        <h1 class="display-6 mb-2">Nominee dashboard</h1>
        <p class="text-muted mb-2">A full-page view of all nominees with profile details, stats, and quick actions.</p>
        <span class="badge bg-secondary">Total nominees: <%= pluralize(@nominees.count, 'nominee') %></span>
      </div>
      <div class="d-flex flex-column flex-sm-row gap-2">
        <%= link_to 'New nominee', new_nominee_path, class: 'btn btn-primary btn-lg' %>
        <%= link_to 'Refresh', nominees_path, class: 'btn btn-outline-secondary btn-lg' %>
      </div>
    </div>

    <div class="row g-4 mb-5">
      <div class="col-lg-4">
        <div class="summary-card p-4 h-100">
          <h3 class="h6 text-uppercase text-muted mb-3">Latest nominee</h3>
          <% if @nominees.any? %>
            <div class="summary-value mb-2"><%= @nominees.first.name.presence || 'Unnamed nominee' %></div>
            <p class="text-muted mb-2">Added <%= time_ago_in_words(@nominees.first.created_at) %> ago</p>
            <p class="text-secondary small mb-0"><strong>Category:</strong> <%= @nominees.first.category.presence || 'Not set' %></p>
          <% else %>
            <div class="summary-value text-muted">No nominees yet</div>
          <% end %>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="summary-card p-4 h-100">
          <h3 class="h6 text-uppercase text-muted mb-3">Insights</h3>
          <p class="mb-3 text-secondary">Keep track of your nominee data coverage and quickly compare contact completion.</p>
          <div class="d-flex flex-column gap-2">
            <span class="badge bg-light text-dark">Emails: <%= @nominees.count { |n| n.email.present? } %></span>
            <span class="badge bg-light text-dark">Mobiles: <%= @nominees.count { |n| n.mobile_number.present? } %></span>
            <span class="badge bg-light text-dark">Addresses: <%= @nominees.count { |n| n.address.present? } %></span>
          </div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="summary-card p-4 h-100">
          <h3 class="h6 text-uppercase text-muted mb-3">How to use</h3>
          <ul class="list-unstyled mb-0">
            <li class="mb-2">• Click <strong>View</strong> to inspect details.</li>
            <li class="mb-2">• Use <strong>Edit</strong> to update nominee profile.</li>
            <li class="mb-0">• Use <strong>Delete</strong> only when a nominee is no longer needed.</li>
          </ul>
        </div>
      </div>
    </div>

    <% if @nominees.any? %>
      <div class="nominee-list-grid">
        <% @nominees.each do |nominee| %>
          <div>
            <%= render nominee %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="alert alert-info">No nominees found yet. Start by creating a new nominee.</div>
    <% end %>
  </div>
</div>
