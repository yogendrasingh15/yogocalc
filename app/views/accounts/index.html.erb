<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1">Accounts</h1>
      <p class="text-muted mb-0">Track accounts, balances, and account status across customers.</p>
    </div>
    <%= link_to "New account", new_account_path, class: "btn btn-primary" %>
  </div>

  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
      <%= form_with url: accounts_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
        <div class="col-md-5">
          <label class="form-label small fw-semibold">Search</label>
          <%= text_field_tag :q, params[:q], class: "form-control", placeholder: "Account number or type" %>
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-semibold">Status</label>
          <%= select_tag :account_status, options_for_select([['All statuses', ''], ['ACTIVE', 'ACTIVE'], ['INACTIVE', 'INACTIVE'], ['CLOSED', 'CLOSED']], params[:account_status]), class: "form-select" %>
        </div>
        <div class="col-md-3 d-flex gap-2">
          <%= submit_tag "Filter", class: "btn btn-primary" %>
          <%= link_to "Reset", accounts_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @accounts.any? %>
    <div class="card shadow-sm border-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Account #</th>
              <th>Customer</th>
              <th>Type</th>
              <th>Status</th>
              <th>Balance</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @accounts.each do |account| %>
              <tr>
                <td class="fw-semibold"><%= account.account_number %></td>
                <td><%= account.customer&.full_name || "—" %></td>
                <td><%= account.account_type.humanize %></td>
                <td><span class="badge bg-info-subtle text-info-emphasis"><%= account.account_status %></span></td>
                <td><%= number_to_currency(account.balance, unit: account.currency_code, format: "%u %n") %></td>
                <td class="text-end">
                  <%= link_to "View", account_path(account), class: "btn btn-sm btn-outline-primary" %>
                  <%= link_to "Edit", edit_account_path(account), class: "btn btn-sm btn-outline-secondary" %>
                  <%= button_to "Delete", account_path(account), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Are you sure?" } } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="alert alert-info">No accounts yet.</div>
  <% end %>
</div>
