<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1">Edit account</h1>
      <p class="text-muted mb-0">Update account details and financial status.</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "Show account", account_path(@account), class: "btn btn-outline-primary" %>
      <%= link_to "Back to accounts", accounts_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <%= render "form", account: @account %>
    </div>
  </div>
</div>
