<aside class="sidebar">
  <div class="list-group">
    <div class="px-3 py-3 mb-2">
      <h6 class="text-white text-uppercase small fw-bold opacity-75">Menu</h6>

    <%= link_to root_path, class: "list-group-item list-group-item-action #{current_page?(root_path) ? 'active' : ''}" do %>
      <i class="bi bi-house-door"></i>
      <span>Dashboard</span>
    <% end %>
    <div class="list-group-item">
      <a class="d-flex justify-content-between align-items-center text-decoration-none text-white" data-bs-toggle="collapse" href="#dryCmsMenu" role="button" aria-expanded="false" aria-controls="dryCmsMenu">
        <div><i class="bi bi-file-earmark-text"></i> <span class="ms-2">DRY CMS</span></div>
        <i class="bi bi-caret-down-fill"></i>
      </a>
      <div class="collapse mt-2" id="dryCmsMenu">
        <ul class="list-group list-group-flush">
          <li class="list-group-item bg-transparent px-0">
            <%= link_to '#', class: "d-flex align-items-center text-decoration-none text-white px-2 py-1" do %>
              <i class="bi bi-house-door me-2"></i>
              <span>Home</span>
            <% end %>
          </li>
          <li class="list-group-item bg-transparent px-0">
            <%= link_to '#', class: "d-flex align-items-center text-decoration-none text-white px-2 py-1" do %>
              <i class="bi bi-layout-text-window-reverse me-2"></i>
              <span>Header</span>
            <% end %>
          </li>
        <li class="list-group-item bg-transparent px-0">
          <%= link_to assets_path, class: "d-flex align-items-center text-decoration-none text-white px-2 py-1" do %>
          <i class="bi bi-layout-text-window-reverse me-2"></i>
          <span>Assets</span>
          <% end %>
        </li>

        <li class="list-group-item bg-transparent px-0">
          <%= link_to custom_pages_path, class: "d-flex align-items-center text-decoration-none text-white px-2 py-1" do %>
          <i class="bi bi-layout-text-window-reverse me-2"></i>
          <span>Custom Pages</span>
          <% end %>
        </li>
        <li class="list-group-item bg-transparent px-0">
          <%= link_to pages_path, class: "d-flex align-items-center text-decoration-none text-white px-2 py-1" do %>
          <i class="bi bi-file-earmark-richtext me-2"></i>
          <span>Pages</span>
          <% end %>
        </li>
        </ul>
      </div>
    </div>

    <%= link_to customers_path, class: "list-group-item list-group-item-action #{current_page?(customers_path) ? 'active' : ''}" do %>
      <i class="bi bi-people"></i>
      <span>Customers</span>
    <% end %>

    <%= link_to accounts_path, class: "list-group-item list-group-item-action #{current_page?(accounts_path) ? 'active' : ''}" do %>
      <i class="bi bi-bank"></i>
      <span>Accounts</span>
    <% end %>

    <%= link_to tickets_path, class: "list-group-item list-group-item-action #{current_page?(tickets_path) ? 'active' : ''}" do %>
      <i class="bi bi-ticket"></i>
      <span>Tickets</span>
    <% end %>

    <%= link_to offers_path, class: "list-group-item list-group-item-action #{current_page?(offers_path) ? 'active' : ''}" do %>
      <i class="bi bi-bag-heart"></i>
      <span>Offers</span>
    <% end %>

    <%= link_to sellers_path, class: "list-group-item list-group-item-action #{current_page?(sellers_path) ? 'active' : ''}" do %>
      <i class="bi bi-shop"></i>
      <span>Sellers</span>
    <% end %>

    <%= link_to bets_path, class: "list-group-item list-group-item-action #{current_page?(bets_path) ? 'active' : ''}" do %>
      <i class="bi bi-dice-5"></i>
      <span>Bets</span>
    <% end %>

    <%= link_to contacts_path, class: "list-group-item list-group-item-action #{current_page?(contacts_path) ? 'active' : ''}" do %>
      <i class="bi bi-person-lines-fill"></i>
      <span>Contacts</span>
    <% end %>

    <%= link_to roles_path, class: "list-group-item list-group-item-action #{current_page?(roles_path) ? 'active' : ''}" do %>
      <i class="bi bi-shield-check"></i>
      <span>Roles</span>
    <% end %>

    <%= link_to profiles_path, class: "list-group-item list-group-item-action #{current_page?(profiles_path) ? 'active' : ''}" do %>
      <i class="bi bi-person-badge"></i>
      <span>Profiles</span>
    <% end %>

    <%= link_to users_path, class: "list-group-item list-group-item-action #{current_page?(users_path) ? 'active' : ''}" do %>
      <i class="bi bi-person-gear"></i>
      <span>Users</span>
    <% end %>

    <%= link_to nominees_path, class: "list-group-item list-group-item-action #{current_page?(nominees_path) ? 'active' : ''}" do %>
      <i class="bi bi-people-fill"></i>
      <span>Nominees</span>
    <% end %>
  </div>
</aside>
<style>

.sidebar .list-group .list-group-item{
 padding: 0px !important;
}
.mt-2 {
    margin-top: -1.0rem !important;
}
</style>
