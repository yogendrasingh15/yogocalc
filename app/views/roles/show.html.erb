<div class="container-fluid p-4">
  <%= render 'shared/page_header', title: 'Role Details', subtitle: 'Review the selected role', action_button: [{ label: 'Edit Role', path: edit_role_path(@role), style: 'primary' }, { label: 'Back to Roles', path: roles_path, style: 'outline-secondary' }] %>

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <%= render @role %>
      <div class="mt-3">
        <%= button_to 'Delete Role', @role, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-outline-danger' %>
      </div>
    </div>
  </div>
</div>
